# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-side only. Needed by `npm run analyze-ticket`.
SUPABASE_SECRET_KEY=your-service-role-key

# Your ecom-suite login email, so `npm run analyze-ticket` can record who ran an analysis.
ECOM_SUITE_USER_EMAIL=you@example.com

# Display name shown against analyses you run. Falls back to your email if unset.
ECOM_SUITE_USER_NAME=Your Name

# Optional. Where your client repo clones live, so analyze-ticket can find them by name.
# Without it, the sibling directory next to this project is checked.
# ECOM_SUITE_REPOS_DIR=/Users/you/code

# Optional. Coding agent used by `npm run analyze-ticket`. Defaults to claude-code.
# ANALYSIS_AGENT=claude-code
